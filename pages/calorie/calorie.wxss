/* pages/calorie/calorie.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
/* 引导 */
.guide {
  text-align: center;
  padding: 60rpx 40rpx;
}
.guide-emoji {
  font-size: 80rpx;
}
.guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin: 16rpx 0 10rpx;
}
.guide-sub {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 30rpx;
}
.guide-btn {
  background: #ff7043;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}
/* 计划概览 */
.plan {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff3ea, #ffe6da);
}
.plan-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #ff7043;
}
.plan-label {
  font-size: 24rpx;
  color: #b5653f;
  margin-top: 4rpx;
}
.plan-sub {
  font-size: 22rpx;
  color: #c08a72;
  margin-top: 10rpx;
}
.plan-right {
  text-align: center;
}
.plan-days {
  font-size: 44rpx;
  font-weight: 800;
  color: #333;
}
.plan-days.done {
  color: #4caf50;
  font-size: 34rpx;
}
.plan-days-unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 4rpx;
}
.plan-days-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
/* 今日环形 */
.today {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ring {
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 10rpx 0 24rpx;
}
.ring-inner {
  width: 210rpx;
  height: 210rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.ring-num {
  font-size: 46rpx;
  font-weight: 800;
  color: #ff7043;
}
.ring-num.over {
  color: #e53935;
}
.ring-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.today-stats {
  display: flex;
  width: 100%;
  justify-content: space-around;
}
.ts {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ts-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.ts-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
/* 快捷操作 */
.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.action {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.a-ico {
  font-size: 44rpx;
}
.a-txt {
  font-size: 24rpx;
  color: #555;
  margin-top: 10rpx;
}
/* 明细 */
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}
.empty {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 30rpx 0;
}
.dt-group {
  margin-top: 10rpx;
}
.dt-head {
  font-size: 24rpx;
  color: #777;
  margin: 14rpx 0 8rpx;
}
.dt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.dt-name {
  font-size: 26rpx;
  color: #444;
}
.dt-kcal {
  font-size: 26rpx;
  color: #ff7043;
  font-weight: 600;
}
