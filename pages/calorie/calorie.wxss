/* pages/calorie/calorie.wxss - 首页视觉升级 */

/* AI 健康教练入口 */
.coach-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1a7a3c, #2fa86a);
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(26, 122, 60, 0.25);
}
.ce-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: flex; align-items: center; justify-content: center;
  margin-right: 22rpx;
}
.ce-text { flex: 1; }
.ce-title { color: #fff; font-size: 32rpx; font-weight: 600; }
.ce-sub { color: rgba(255,255,255,0.82); font-size: 24rpx; margin-top: 6rpx; }
.ce-arrow { color: #fff; font-size: 48rpx; opacity: 0.7; }

/* 生长中心入口 */
.growth-center {
  margin-bottom: 24rpx;
}
.gc-grid {
  display: flex;
  gap: 18rpx;
}
.gc-card {
  flex: 1;
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,.05);
}
.gc-icon {
  font-size: 48rpx;
  line-height: 1;
}
.gc-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #18352d;
  margin-top: 14rpx;
}

/* 顶部 Banner —— 图片全铺、文字叠加左下角不挡人 */
.fitness-banner {
  position: relative;
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(255, 126, 138, 0.28);
}
.fitness-banner-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: block;
}
/* 底部渐变遮罩 —— 让文字清晰可读 */
.fitness-banner-overlay {
  position: absolute;
  left: 0; bottom: 0; right: 0;
  height: 65%;
  background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);
  pointer-events: none;
}
/* 文字区：严格限制左下角，不越过中线 */
.fitness-banner-copy {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  width: 52%;
  max-width: 380rpx;
  z-index: 2;
  color: #fff;
}
.fitness-banner-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
  line-height: 1.4;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.3);
}
.fitness-banner-sub {
  font-size: 22rpx;
  line-height: 1.45;
  opacity: 0.88;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.25);
}

/* 健康概览顶部条 */
.ov-top {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: 24rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid #f0f1ef;
}
.ov-top-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ov-top-val {
  font-size: 38rpx;
  font-weight: 700;
  color: #1d1d1f;
}
.ov-top-val.bmi-low { color: #2f80ed; }
.ov-top-val.bmi-normal { color: #2fa86a; }
.ov-top-val.bmi-high { color: #ef8c2f; }
.ov-top-val.bmi-obese { color: #e53935; }
.ov-top-unit { font-size: 22rpx; font-weight: 500; color: #9ca3af; }
.ov-top-label { font-size: 22rpx; color: #9ca3af; margin-top: 6rpx; }
.ov-top-div {
  width: 1rpx;
  height: 56rpx;
  background: #f0f1ef;
}
/* 隐私眼睛按钮（使用统一线性图标 .icon） */
.ov-eye {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-left: 4rpx;
}
.ov-eye .icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}
.ov-eye:active .icon {
  opacity: 1;
}
.ov-top-item--privacy .ov-top-val {
  letter-spacing: 2rpx;
}

/* 进度概览卡片 */
.result-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.result-ring {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}
.ring-bg {
  stroke: #f0ede9;
}
.ring-fg {
  stroke: #ff7e8a;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.ring-center {
  text-anchor: middle;
  fill: #1d1d1f;
  font-size: 42rpx;
  font-weight: 800;
}
.ring-center-sub {
  text-anchor: middle;
  fill: #b0b5ba;
  font-size: 20rpx;
}

/* 概览指标行 —— 更精致的卡片式 */
.metrics {
  display: flex;
  border-top: 1rpx solid #f2efe9;
  padding-top: 28rpx;
}
.metric {
  flex: 1;
  text-align: center;
  position: relative;
}
.metric + .metric::before {
  content: "";
  position: absolute;
  left: 0;
  top: 4rpx;
  bottom: 12rpx;
  width: 1rpx;
  background: #f2efe9;
}
.metric-val {
  font-size: 38rpx;
  font-weight: 800;
  color: #1d1d1f;
  letter-spacing: -0.5rpx;
}
.metric-val.pos { color: #2fa86a; }
.metric-label {
  font-size: 21rpx;
  color: #b0b5ba;
  margin-top: 10rpx;
}

/* 今日明细 */
.detail { margin-bottom: 24rpx; }
.dt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.dt-row + .dt-row { border-top: 1rpx solid #f5f6f4; }
.dt-row:active { background: #faf7f4; }
.dt-name { font-size: 28rpx; color: #1d1d1f; }
.dt-sub { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.dt-kcal { font-size: 26rpx; color: #ff7e8a; font-weight: 600; }
.detail-hint {
  text-align: center;
  color: #b0b5ba;
  font-size: 21rpx;
  padding-top: 14rpx;
}
.empty-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 24rpx 0;
}

/* AI 饮食推荐 */
.reco {
  background: linear-gradient(135deg, #eef4ff, #f3eaff);
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}
.reco-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  color: #6a5acd;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.reco-list { display: flex; flex-direction: column; gap: 12rpx; }
.reco-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  transition: transform 0.15s ease;
}
.reco-item:active { transform: scale(0.98); }
.reco-main { display: flex; flex-direction: column; }
.reco-name { font-size: 26rpx; color: #333; font-weight: 500; }
.reco-cat { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.reco-kcal { font-size: 22rpx; color: #ff7e8a; }

/* 操作按钮 —— 统一卡片风格，主次分明 */
.actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 8rpx;
}
.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 20rpx;
  padding: 28rpx 0 22rpx;
  text-align: center;
  font-size: 25rpx;
  font-weight: 500;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
/* 四个按钮统一浅底同色系，不深红 */
.action-btn.tap {
  background: #fff5f6;
  color: #c85a66;
  box-shadow: 0 2rpx 12rpx rgba(200, 90, 102, 0.06);
}
/* 次要操作：同色系浅底 */
.action-btn.ghost {
  background: #fff5f6;
  color: #c85a66;
  box-shadow: 0 2rpx 12rpx rgba(200, 90, 102, 0.06);
}
.action-btn:active { transform: scale(0.96); opacity: 0.88; }
.action-btn.ghost:active { background: #ffeef0; }

/* 引导卡 */
.guide { text-align: center; padding: 48rpx 32rpx; }
.guide-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #fff3f4;
  display: flex;
  align-items: center;
  justify-content: center;
}
.guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d1d1f;
  margin-bottom: 12rpx;
}
.guide-sub {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-bottom: 32rpx;
}
.guide-btn { width: 100%; }

/* 明细分组标题 */
.dt-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #4b5563;
  margin: 12rpx 0 8rpx;
}
