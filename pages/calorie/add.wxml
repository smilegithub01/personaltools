<!--pages/calorie/add.wxml-->
<view class="container">
  <view class="tabs">
    <view class="tab {{tab==='food'?'on':''}}" data-tab="food" bindtap="onTab"><view class="icon icon-food {{tab==='food'?'p':'m'}}"></view>记饮食</view>
    <view class="tab {{tab==='exercise'?'on':''}}" data-tab="exercise" bindtap="onTab"><view class="icon icon-ex {{tab==='exercise'?'p':'m'}}"></view>记运动</view>
  </view>

  <!-- 饮食 -->
  <block wx:if="{{tab==='food'}}">
    <view class="search">
      <input class="search-input" placeholder="搜索食物，如 米饭 / 鸡胸肉 / 鸡肉" value="{{kw}}" bindinput="onKw" />
    </view>
    <view class="freq" wx:if="{{frequent.length>0}}">
      <view class="freq-label">常吃</view>
      <view class="freq-list">
        <view class="freq-item" wx:for="{{frequent}}" wx:key="name" data-name="{{item.name}}" bindtap="onFrequent">{{item.name}}</view>
      </view>
    </view>
    <scroll-view scroll-y class="list">
      <view class="item {{selFood && selFood.name===item.name ? 'on':''}}" wx:for="{{foods}}" wx:key="name" data-name="{{item.name}}" bindtap="onPickFood">
        <view>
          <view class="item-name">{{item.name}}</view>
          <view class="item-cat">{{item.cat}}</view>
        </view>
        <text class="item-kcal">{{item.kcal}}/100g</text>
      </view>
      <view class="empty-tip" wx:if="{{foods.length===0}}">没有找到「{{kw}}」</view>
    </scroll-view>

    <!-- 饮食录入面板 -->
    <view class="panel" wx:if="{{selFood}}">
      <view class="panel-head">
        <view><text class="panel-name">{{selFood.name}}</text><text class="panel-cat">{{selFood.cat}}</text></view>
        <text class="panel-close" bindtap="onClosePanel">×</text>
      </view>
      <view class="meal-row">
        <text class="meal-label">餐次</text>
        <view class="meal-seg">
          <view class="meal-opt {{meal===m?'on':''}}" wx:for="{{meals}}" wx:key="*this" data-m="{{item}}" bindtap="onMeal">{{item}}</view>
        </view>
      </view>
      <view class="amount">
        <input class="amount-input" type="digit" placeholder="克数" value="{{grams}}" bindinput="onGrams" />
        <text class="amount-unit">g</text>
        <text class="amount-kcal" wx:if="{{foodKcal>0}}">≈ {{foodKcal}} kcal</text>
      </view>
      <view class="quick" style="display:flex;gap:14rpx;margin-bottom:24rpx">
        <view class="freq-item" wx:for="{{[50,100,150,200]}}" wx:key="*this" data-g="{{item}}" bindtap="onQuick">{{item}}g</view>
      </view>
      <button class="btn-primary" bindtap="onAddFood">添加到今日</button>
    </view>
  </block>

  <!-- 运动 -->
  <block wx:if="{{tab==='exercise'}}">
    <view class="search">
      <input class="search-input" placeholder="搜索运动，如 跑步 / 游泳 / run" value="{{ekw}}" bindinput="onEkw" />
    </view>
    <scroll-view scroll-y class="list">
      <view class="item {{selEx && selEx.name===item.name ? 'on':''}}" wx:for="{{exercises}}" wx:key="name" data-name="{{item.name}}" bindtap="onPickEx">
        <view>
          <view class="item-name">{{item.name}}</view>
          <view class="item-cat">MET {{item.met}}</view>
        </view>
        <text class="item-kcal">点选</text>
      </view>
      <view class="empty-tip" wx:if="{{exercises.length===0}}">没有找到「{{ekw}}」</view>
    </scroll-view>

    <!-- 运动录入面板 -->
    <view class="panel" wx:if="{{selEx}}">
      <view class="panel-head">
        <view><text class="panel-name">{{selEx.name}}</text><text class="panel-cat">MET {{selEx.met}} · {{weight}}kg</text></view>
        <text class="panel-close" bindtap="onClosePanel">×</text>
      </view>
      <view class="amount">
        <input class="amount-input" type="digit" placeholder="时长" value="{{minutes}}" bindinput="onMinutes" />
        <text class="amount-unit">分钟</text>
        <text class="amount-kcal" wx:if="{{exKcal>0}}">≈ {{exKcal}} kcal</text>
      </view>
      <button class="btn-primary" bindtap="onAddEx">添加到今日</button>
    </view>
  </block>
</view>
