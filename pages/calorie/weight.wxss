/* pages/calorie/weight.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.today-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 14rpx;
}
.today-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.today-input {
  flex: 1;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
}
.today-unit {
  color: #999;
  font-size: 26rpx;
}
.today-btn {
  background: #ff7043;
  color: #fff;
  font-size: 26rpx;
  padding: 0 36rpx;
  line-height: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  margin: 0;
}
.ov-grid {
  display: flex;
  justify-content: space-between;
}
.ov-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.ov-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
}
.ov-item.hl .ov-num {
  color: #4caf50;
}
.ov-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  margin: 24rpx 0 14rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff9a6c, #ff7043);
  border-radius: 10rpx;
  transition: width 0.3s;
}
.ov-foot {
  font-size: 24rpx;
  color: #777;
  text-align: center;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}
.trend-canvas {
  width: 100%;
  height: 320rpx;
}
.trend-hint {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 20rpx 0;
}
.hi-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.hi-row:last-child {
  border-bottom: none;
}
.hi-date {
  flex: 1;
  font-size: 26rpx;
  color: #555;
}
.hi-weight {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}
.hi-del {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: #e53935;
}
.empty {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  padding: 30rpx 0;
}
