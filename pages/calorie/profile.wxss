/* pages/calorie/profile.wxss */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.row:last-child {
  border-bottom: none;
}
.row.col {
  flex-direction: column;
  align-items: stretch;
}
.label {
  width: 180rpx;
  font-size: 28rpx;
  color: #444;
}
.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}
.unit {
  width: 60rpx;
  text-align: right;
  color: #999;
  font-size: 26rpx;
}
.seg {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}
.seg-item {
  padding: 10rpx 36rpx;
  border-radius: 30rpx;
  background: #f2f2f2;
  color: #666;
  font-size: 28rpx;
}
.seg-item.on {
  background: #ff7043;
  color: #fff;
}
.picker {
  flex: 1;
  text-align: right;
}
.picker-text {
  font-size: 28rpx;
  color: #222;
}
.rate-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.rate-val {
  font-size: 28rpx;
  color: #ff7043;
  font-weight: 600;
}
.hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}
.result {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.res-item {
  flex: 1 1 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.res-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}
.res-item.hl .res-num {
  color: #ff7043;
}
.res-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}
.res-warn {
  flex-basis: 100%;
  font-size: 22rpx;
  color: #e53935;
  background: #fff3f2;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-top: 8rpx;
}
.save-btn {
  background: #ff7043;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  margin-top: 12rpx;
}
