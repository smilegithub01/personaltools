/* pages/calorie/add.wxss - 记录页视觉升级 */

/* 顶部标签切换 */
.tabs {
  display: flex;
  background: #fff;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 14rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}
.tab.on {
  background: linear-gradient(135deg, #ff9a9e, #ff7e8a);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 126, 138, 0.3);
}

/* 搜索框 */
.search {
  padding: 0;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.search-input {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1d1d1f;
}

/* 常吃快捷 */
.freq {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.freq-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 14rpx;
}
.freq-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.freq-item {
  padding: 12rpx 24rpx;
  background: #fff3ec;
  color: #ff7e8a;
  border-radius: 24rpx;
  font-size: 25rpx;
  transition: transform 0.15s ease, background 0.15s ease;
}
.freq-item:active {
  transform: scale(0.95);
  background: #ffe2d3;
}

/* 候选列表 */
.list {
  height: calc(100vh - 560rpx);
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 53, 45, 0.05);
  transition: transform 0.15s ease, background 0.15s ease;
}
.item:active {
  transform: scale(0.985);
  background: #fff8f4;
}
.item.on {
  background: #fff3ec;
  box-shadow: 0 4rpx 16rpx rgba(255, 126, 138, 0.12);
}
.item-name { font-size: 29rpx; color: #1d1d1f; font-weight: 500; }
.item-cat { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.item-kcal { font-size: 26rpx; color: #ff7e8a; font-weight: 600; }
.empty-tip { text-align: center; color: #9ca3af; font-size: 24rpx; padding: 40rpx 0; }

/* 底部录入面板 */
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(24, 53, 45, 0.1);
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.panel-name { font-size: 30rpx; font-weight: 600; color: #1d1d1f; }
.panel-cat { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }
.panel-close {
  font-size: 40rpx;
  color: #c4c8c4;
  line-height: 1;
  padding: 0 8rpx;
}

/* 餐次选择 */
.meal-row { margin-bottom: 22rpx; }
.meal-label { font-size: 25rpx; color: #6b7280; margin-bottom: 12rpx; display: block; }
.meal-seg {
  display: flex;
  background: #f1f3f1;
  border-radius: 14rpx;
  padding: 6rpx;
  gap: 6rpx;
}
.meal-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 25rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}
.meal-opt.on {
  background: #fff;
  color: #ff7e8a;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 53, 45, 0.08);
}

/* 数值输入 */
.amount {
  display: flex;
  align-items: center;
  background: #f6f7f5;
  border: 1rpx solid #eceeeb;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.amount:focus-within { border-color: #ff7e8a; background: #fff; }
.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
}
.amount-unit { font-size: 26rpx; color: #9ca3af; margin-left: 8rpx; }
.amount-kcal {
  font-size: 24rpx;
  color: #ff7e8a;
  font-weight: 600;
  margin-left: 16rpx;
}
