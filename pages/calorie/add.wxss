/* pages/calorie/add.wxss - 记录页视觉升级 */

/* 顶部标签切换（可横滑） */
.tabs-scroll {
  margin-bottom: 24rpx;
  white-space: nowrap;
}
.tabs {
  display: inline-flex;
  background: #fff;
  border-radius: 18rpx;
  padding: 6rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  text-align: center;
  padding: 20rpx 36rpx;
  font-size: 28rpx;
  color: #6b7280;
  border-radius: 14rpx;
  font-weight: 500;
  transition: all 0.2s ease;
  white-space: nowrap;
}
.tab.on {
  background: linear-gradient(135deg, #ff9a9e, #ff7e8a);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 126, 138, 0.3);
}

/* 本次已添加计数条：默认低对比占位，有项后高亮 + 完成按钮 */
.added-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 14rpx;
  background: #f1f3f1;
  color: #9ca3af;
  font-size: 25rpx;
  transition: all 0.25s ease;
}
.added-bar.show {
  background: #fff3ec;
  color: #ff7e8a;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(255, 126, 138, 0.15);
}
.added-text { font-size: 25rpx; }
.added-done {
  padding: 8rpx 28rpx;
  background: #ff7e8a;
  color: #fff;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
}
.added-bar:not(.show) .added-done {
  background: #d1d5db;
  color: #fff;
}
.added-done:active { transform: scale(0.95); }

/* 搜索框 */
.search {
  padding: 0;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.search-input {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: #1d1d1f;
}

/* 常吃快捷 */
.freq {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
}
.freq-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 14rpx;
}
.freq-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.freq-item {
  padding: 12rpx 24rpx;
  background: #fff3ec;
  color: #ff7e8a;
  border-radius: 24rpx;
  font-size: 25rpx;
  transition: transform 0.15s ease, background 0.15s ease;
}
.freq-item:active {
  transform: scale(0.95);
  background: #ffe2d3;
}

/* 自定义食物入口 */
.custom-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 53, 45, 0.05);
  border: 1rpx dashed #ffd0c4;
  transition: transform 0.15s ease, background 0.15s ease;
}
.custom-entry:active {
  transform: scale(0.985);
  background: #fff8f4;
}
.custom-entry-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.custom-entry-text { font-size: 28rpx; color: #ff7e8a; font-weight: 600; }
.custom-entry-hint { font-size: 22rpx; color: #9ca3af; }
.custom-entry-arrow { font-size: 36rpx; color: #ffb3a8; line-height: 1; }

/* 候选列表 */
.list {
  height: calc(100vh - 560rpx);
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 53, 45, 0.05);
  transition: transform 0.15s ease, background 0.15s ease;
}
.item:active {
  transform: scale(0.985);
  background: #fff8f4;
}
.item.on {
  background: #fff3ec;
  box-shadow: 0 4rpx 16rpx rgba(255, 126, 138, 0.12);
}
.item-name { font-size: 29rpx; color: #1d1d1f; font-weight: 500; }
.item-cat { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.item-kcal { font-size: 26rpx; color: #ff7e8a; font-weight: 600; }
.empty-tip { text-align: center; color: #9ca3af; font-size: 24rpx; padding: 40rpx 0; }

/* 底部录入面板 */
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 30rpx rgba(24, 53, 45, 0.1);
  transform: translateY(0);
  transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.panel-name { font-size: 30rpx; font-weight: 600; color: #1d1d1f; }
.panel-cat { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }
.panel-close {
  font-size: 40rpx;
  color: #c4c8c4;
  line-height: 1;
  padding: 0 8rpx;
}

/* 餐次选择 */
.meal-row { margin-bottom: 22rpx; }
.meal-label { font-size: 25rpx; color: #6b7280; margin-bottom: 12rpx; display: block; }
.meal-seg {
  display: flex;
  background: #f1f3f1;
  border-radius: 14rpx;
  padding: 6rpx;
  gap: 6rpx;
}
.meal-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 25rpx;
  color: #6b7280;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}
.meal-opt.on {
  background: #fff;
  color: #ff7e8a;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 53, 45, 0.08);
}

/* 数值输入 */
.amount {
  display: flex;
  align-items: center;
  background: #f6f7f5;
  border: 1rpx solid #eceeeb;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.amount:focus-within { border-color: #ff7e8a; background: #fff; }
.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #1d1d1f;
}
.amount-unit { font-size: 26rpx; color: #9ca3af; margin-left: 8rpx; }
.amount-kcal {
  font-size: 24rpx;
  color: #ff7e8a;
  font-weight: 600;
  margin-left: 16rpx;
}

/* 自定义食物输入行 */
.custom-row {
  display: flex;
  align-items: center;
  background: #f6f7f5;
  border: 1rpx solid #eceeeb;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 18rpx;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.custom-row:focus-within { border-color: #ff7e8a; background: #fff; }
.custom-input {
  flex: 1;
  font-size: 28rpx;
  color: #1d1d1f;
}
.custom-unit { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }

/* ===== 复制昨日 ===== */
.copy-yesterday {
  background: #f0f7f4;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 18rpx;
}
.cy-label { font-size: 24rpx; color: #2fa86a; font-weight: 600; margin-bottom: 12rpx; }
.cy-row { display: flex; gap: 14rpx; flex-wrap: wrap; }
.cy-chip {
  background: #fff;
  border: 1rpx solid #d8e6db;
  color: #18352d;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}
.cy-chip.all { background: #2fa86a; color: #fff; border-color: #2fa86a; }
.cy-chip:active { transform: scale(0.95); }

/* ===== 面板操作区（收藏+关闭） ===== */
.panel-actions { display: flex; align-items: center; gap: 16rpx; }
.panel-favor { font-size: 36rpx; color: #ff9a9e; }

/* ===== 扩展模块通用卡片（饮水/围度/经期） ===== */
.ext-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 4rpx 18rpx rgba(24, 53, 45, 0.06);
}
.ext-title { font-size: 32rpx; font-weight: 600; color: #1d1d1f; margin-bottom: 28rpx; }
.ext-hint { font-size: 22rpx; color: #9ca3af; margin-top: 24rpx; text-align: center; line-height: 1.5; }

/* ===== 饮水 ===== */
.water-display { display: flex; align-items: baseline; margin-bottom: 20rpx; }
.water-num { font-size: 72rpx; font-weight: 700; color: #4facfe; line-height: 1; }
.water-unit { font-size: 28rpx; color: #4facfe; margin-left: 8rpx; }
.water-goal { font-size: 26rpx; color: #9ca3af; margin-left: 12rpx; }
.water-progress {
  height: 20rpx;
  background: #e8f4ff;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}
.water-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4facfe, #00c6fb);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}
.water-actions { display: flex; gap: 18rpx; margin-bottom: 18rpx; }
.water-btn {
  flex: 1;
  text-align: center;
  background: #e8f4ff;
  color: #4facfe;
  font-size: 28rpx;
  font-weight: 600;
  padding: 22rpx 0;
  border-radius: 16rpx;
}
.water-btn:active { transform: scale(0.95); background: #d0ebff; }
.water-sub-row { display: flex; gap: 18rpx; }
.water-sub-btn {
  flex: 1;
  text-align: center;
  background: #f5f5f5;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
}
.water-sub-btn:active { background: #ececec; }

/* ===== 围度 ===== */
.measure-form { margin-bottom: 28rpx; }
.measure-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.measure-label { font-size: 28rpx; color: #4b5563; width: 160rpx; }
.measure-input {
  flex: 1;
  font-size: 30rpx;
  color: #1d1d1f;
  text-align: right;
  padding-right: 12rpx;
}
.measure-unit { font-size: 24rpx; color: #9ca3af; width: 50rpx; }

/* ===== 经期 ===== */
.period-status {
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  margin-bottom: 28rpx;
}
.period-status.on { background: #fff0f0; }
.period-status-text { font-size: 28rpx; color: #9ca3af; }
.period-status.on .period-status-text { color: #ff7e8a; font-weight: 600; }
.period-settings { margin: 28rpx 0; }
.period-next {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.period-next-label { font-size: 26rpx; color: #6b7280; }
.period-next-date { font-size: 28rpx; font-weight: 600; color: #ff7e8a; }
