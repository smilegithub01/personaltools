/* pages/converter/converter.wxss */
.cats {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.cat {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #666;
}

.cat-active {
  background: #07c160;
  color: #fff;
  font-weight: 500;
}

.panel {
  padding: 32rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.val {
  flex: 1;
  font-size: 44rpx;
  font-weight: 600;
  color: #222;
}

.result {
  color: #07c160;
}

.unit {
  margin-left: 24rpx;
}

.unit-text {
  font-size: 28rpx;
  color: #333;
  background: #f3f3f3;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  min-width: 160rpx;
  text-align: center;
}

.swap {
  text-align: center;
  font-size: 44rpx;
  color: #07c160;
  padding: 8rpx 0;
}

.swap:active {
  opacity: 0.6;
}
