<!--pages/converter/converter.wxml-->
<view class="container">
  <!-- 分类切换 -->
  <scroll-view class="cats" scroll-x>
    <view
      class="cat {{index === activeCat ? 'cat-active' : ''}}"
      wx:for="{{categories}}"
      wx:key="name"
      data-i="{{index}}"
      bindtap="onCategory"
    >{{item.name}}</view>
  </scroll-view>

  <view class="card panel">
    <!-- 源 -->
    <view class="row">
      <input
        class="val"
        type="digit"
        placeholder="输入数值"
        value="{{inputValue}}"
        bindinput="onInput"
      />
      <picker class="unit" range="{{units}}" value="{{fromIndex}}" bindchange="onFromUnit">
        <view class="unit-text">{{units[fromIndex]}} ▾</view>
      </picker>
    </view>

    <view class="swap" bindtap="onSwap">⇅</view>

    <!-- 目标 -->
    <view class="row">
      <view class="val result">{{resultValue}}</view>
      <picker class="unit" range="{{units}}" value="{{toIndex}}" bindchange="onToUnit">
        <view class="unit-text">{{units[toIndex]}} ▾</view>
      </picker>
    </view>
  </view>
</view>
