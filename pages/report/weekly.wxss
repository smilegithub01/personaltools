/* pages/report/weekly.wxss —— 可分享周报卡片 */
.report-page {
  min-height: 100vh;
  background: #f6f7f5;
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card-wrap {
  display: flex;
  justify-content: center;
}
.card-canvas {
  width: 600rpx;   /* 2x 的 300px */
  height: 920rpx;  /* 2x 的 460px */
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.12);
}

.report-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}
.rs-item {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,.04);
}
.rs-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #18352d;
}
.rs-label {
  font-size: 22rpx;
  color: #8a988f;
  margin-top: 6rpx;
}

.report-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.r-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
.r-btn.primary {
  background: linear-gradient(90deg, #2f7d5b, #4ea15a);
  color: #fff;
  border: none;
}
.r-btn.ghost {
  background: #fff;
  color: #2f7d5b;
  border: 2rpx solid #bfe0cc;
}
.report-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa89f;
  margin-top: 20rpx;
}
