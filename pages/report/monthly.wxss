/* pages/report/monthly.wxss —— 可分享月报卡片 */
.report-page {
  min-height: 100vh;
  background: #f6f7f5;
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card-wrap {
  display: flex;
  justify-content: center;
}
.card-canvas {
  width: 600rpx;   /* 2x 的 300px */
  height: 920rpx;  /* 2x 的 460px */
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.12);
}
.card-canvas-month {
  height: 1040rpx; /* 2x 的 520px，容纳体重曲线 */
}

.report-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}
.rs-item {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(24,53,45,0.06);
}
.rs-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #18352d;
}
.rs-label {
  font-size: 22rpx;
  color: #8a988f;
  margin-top: 6rpx;
}

/* 体重变化卡片 */
.weight-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,53,45,0.06);
}
.wc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #18352d;
  margin-bottom: 22rpx;
}
.wc-row {
  display: flex;
  align-items: center;
}
.wc-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.wc-label {
  font-size: 22rpx;
  color: #9aa89f;
  margin-bottom: 6rpx;
}
.wc-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #18352d;
}
.wc-arrow {
  font-size: 36rpx;
  color: #c5d6cc;
  margin: 0 16rpx;
}
.wc-change {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}
/* 减重：正面绿 */
.wc-change--1 {
  color: #2fa86a;
  background: rgba(47,168,106,.12);
}
/* 增重 */
.wc-change-1 {
  color: #ff7e8a;
  background: rgba(255,126,138,.12);
}
/* 持平 */
.wc-change-0 {
  color: #8a988f;
  background: rgba(138,152,143,.12);
}

/* 营养素分析卡片 */
.nutrient-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(24,53,45,0.06);
}
.nc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #18352d;
  margin-bottom: 22rpx;
}
.nutrient-body {
  display: flex;
  align-items: center;
}
.nutrient-ring {
  flex-shrink: 0;
  margin-right: 24rpx;
}
.nutrient-list {
  flex: 1;
}
.nutrient-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}
.nutrient-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.nutrient-name {
  font-size: 26rpx;
  color: #4b5563;
  width: 100rpx;
}
.nutrient-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1d1d1f;
  flex: 1;
  text-align: right;
}
.nutrient-pct {
  font-size: 24rpx;
  color: #9ca3af;
  width: 70rpx;
  text-align: right;
}
.nutrient-hint {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 18rpx;
  text-align: center;
}

.report-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.r-btn {
  flex: 1;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  line-height: 1.4;
}
.r-btn.primary {
  background: linear-gradient(90deg, #2f7d5b, #4ea15a);
  color: #fff;
  border: none;
}
.r-btn.ghost {
  background: #fff;
  color: #2f7d5b;
  border: 2rpx solid #bfe0cc;
}
.report-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa89f;
  margin-top: 20rpx;
}
