/* pages/rank/rank.wxss —— 好友生长榜 */
.rank-page {
  min-height: 100vh;
  background: #f6f7f5;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 我的卡片 */
.my-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1d3b32, #2f7d5b);
  border-radius: 24rpx;
  padding: 28rpx;
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(31,59,50,.25);
}
.my-avatar {
  width: 96rpx; height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255,255,255,.2);
  border: 4rpx solid rgba(255,255,255,.4);
}
.my-avatar-img {
  width: 100%; height: 100%;
  display: block;
}
.my-info {
  margin-left: 22rpx;
  flex: 1;
}
.my-name-row {
  display: flex;
  align-items: center;
}
.my-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.my-rank-badge {
  margin-left: 16rpx;
  font-size: 22rpx;
  background: #ffd66b;
  color: #5a3b00;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.my-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(255,255,255,.75);
  margin-top: 10rpx;
}

/* 榜单 */
.rank-list {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,.04);
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  border-bottom: 2rpx solid #f1f3f1;
}
.rank-item:last-child { border-bottom: none; }
.rank-item.is-me {
  background: #eef9f1;
}

.rank-no {
  width: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #9aa89f;
}
.rank-no-1 { color: #f0a500; }
.rank-no-2 { color: #9bb0bd; }
.rank-no-3 { color: #cd8a5a; }

.rank-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #eef3ef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 22rpx;
}
.rank-avatar-img {
  width: 100%; height: 100%;
  display: block;
}
.rank-avatar-emoji {
  font-size: 40rpx;
}

.rank-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #18352d;
}
.rank-desc {
  font-size: 20rpx;
  color: #8a988f;
  margin-top: 4rpx;
}

.rank-streak {
  display: flex;
  align-items: baseline;
}
.rank-streak-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f7d5b;
}
.rank-streak-unit {
  font-size: 20rpx;
  color: #8a988f;
  margin-left: 4rpx;
}

/* 邀请 */
.rank-actions {
  margin-top: 32rpx;
}
.rank-btn {
  width: 100%;
  background: linear-gradient(90deg, #2f7d5b, #4ea15a);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 22rpx 0;
  border: none;
}
.rank-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa89f;
  margin-top: 20rpx;
}
