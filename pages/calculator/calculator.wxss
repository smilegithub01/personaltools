/* pages/calculator/calculator.wxss */
.calc {
  padding: 24rpx;
}

.display {
  margin-bottom: 24rpx;
  text-align: right;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.display .expr {
  font-size: 28rpx;
  color: #999;
  min-height: 36rpx;
  word-break: break-all;
}

.display .result {
  font-size: 72rpx;
  font-weight: 600;
  color: #222;
  word-break: break-all;
}

.keys {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.key {
  height: 130rpx;
  line-height: 130rpx;
  text-align: center;
  font-size: 44rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.key:active {
  background: #eaeaea;
}

.key-fn {
  color: #07c160;
  font-weight: 500;
}

.key-op {
  background: #07c160;
  color: #ffffff;
  font-weight: 600;
}

.key-op:active {
  background: #06ad56;
}

.key-eq {
  background: #ff9500;
  color: #ffffff;
  font-weight: 600;
}

.key-eq:active {
  background: #e6860a;
}

.key-zero {
  grid-column: span 2;
}
