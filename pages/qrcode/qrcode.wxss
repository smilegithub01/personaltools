/* pages/qrcode/qrcode.wxss */
.input {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-gen {
  background: #07c160;
  color: #fff;
}

.btn-gen:active {
  background: #06ad56;
}

.btn-scan {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
}

.btn-scan:active {
  background: #f0f9eb;
}

.scan-result {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #888;
  word-break: break-all;
}

.qr-box {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.qr-placeholder {
  width: 220px;
  height: 220px;
  line-height: 220px;
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
  border: 2rpx dashed #e0e0e0;
  border-radius: 12rpx;
}

.qr-canvas {
  background: #fff;
}

.btn-save {
  margin-top: 28rpx;
  background: #ff9500;
  color: #fff;
  width: 220px;
}

.btn-save:active {
  background: #e6860a;
}
