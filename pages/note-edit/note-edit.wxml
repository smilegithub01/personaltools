<!--pages/note-edit/note-edit.wxml-->
<view class="container edit">
  <view class="field card">
    <input
      class="title-input"
      placeholder="标题"
      value="{{title}}"
      maxlength="50"
      bindinput="onTitleInput"
    />
  </view>

  <view class="field card content-card">
    <textarea
      class="content-input"
      placeholder="写点什么…"
      value="{{content}}"
      maxlength="5000"
      auto-height
      bindinput="onContentInput"
    />
  </view>

  <view class="actions">
    <view wx:if="{{!isNew}}" class="btn-del" bindtap="onDelete">删除</view>
    <view class="btn-save" bindtap="onSave">保存</view>
  </view>
</view>
