/* pages/note-edit/note-edit.wxss */
.edit {
  padding: 24rpx;
}

.field {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.title-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
}

.content-card {
  min-height: 320rpx;
}

.content-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.6;
  color: #444;
  min-height: 300rpx;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.btn-save {
  flex: 1;
  background: #07c160;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn-save:active {
  background: #06ad56;
}

.btn-del {
  width: 200rpx;
  background: #fff;
  color: #e54d42;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: 1rpx solid #f0d4d1;
}

.btn-del:active {
  opacity: 0.7;
}
