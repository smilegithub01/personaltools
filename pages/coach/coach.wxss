/* pages/coach/coach.wxss —— 健康贴士 */

/* 顶部概览卡 */
.hero-card {
  background: linear-gradient(135deg, #18352d, #2fa86a);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(24, 53, 45, 0.15);
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.hero-title {
  font-size: 36rpx;
  font-weight: 600;
}
.hero-goal {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}
.hero-metrics {
  display: flex;
  justify-content: space-between;
}
.hero-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.hero-val {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}
.hero-val.pos { color: #fff; }
.hero-val.neg { color: #ffb3a8; }
.hero-lab {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

/* 每周计划卡 */
.plan-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(24, 53, 45, 0.06);
}
.plan-row {
  display: flex;
  align-items: center;
}
.plan-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.plan-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #18352d;
}
.plan-lab {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}
.plan-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e5e7eb;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.qa-btn {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(24, 53, 45, 0.06);
  transition: transform 0.15s ease;
}
.qa-btn:active {
  transform: scale(0.97);
  background: #f9faf9;
}
.qa-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}
.qa-text {
  font-size: 26rpx;
  color: #1d1d1f;
  font-weight: 500;
}

/* 贴士区 */
.tips-section {
  margin-top: 8rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 20rpx;
}

.tip-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 18rpx rgba(24, 53, 45, 0.06);
  transition: transform 0.2s ease;
}
.tip-card:active {
  transform: scale(0.99);
}
.tip-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.tip-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.tip-body {
  flex: 1;
}
.tip-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 6rpx;
}
.tip-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #2fa86a;
  background: #e8f5ee;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.tip-content {
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.6;
  padding-left: 64rpx;
}

.empty-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 60rpx 0;
}
