<!--pages/notes/notes.wxml-->
<view class="container">
  <view wx:if="{{notes.length === 0}}" class="empty card">
    <view class="empty-emoji">📝</view>
    <view class="empty-text">还没有备忘录，点右下角 + 新建一条</view>
  </view>

  <view
    class="note-item card"
    wx:for="{{notes}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onOpen"
  >
    <view class="note-title">{{item.title || '（无标题）'}}</view>
    <view class="note-content">{{item.content || '（空内容）'}}</view>
    <view class="note-foot">
      <text class="note-time">{{item.timeText}}</text>
      <text class="note-del" catchtap="onDelete" data-id="{{item.id}}">删除</text>
    </view>
  </view>

  <view class="fab" bindtap="onAdd">＋</view>
</view>
