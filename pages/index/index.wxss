/* pages/index/index.wxss */
.header {
  text-align: center;
  background: linear-gradient(135deg, #07c160 0%, #1aad19 100%);
  color: #ffffff;
}

.header .title {
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.header .subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

.tool-grid {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.tool-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
}

.tool-item:active {
  background-color: #f9f9f9;
}

.tool-icon {
  font-size: 56rpx;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background-color: #f0f9eb;
  border-radius: 50%;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.tool-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tool-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tool-desc {
  font-size: 24rpx;
  color: #999;
}

.footer {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbb;
}
