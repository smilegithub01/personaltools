<!--pages/index/index.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="header card">
    <view class="title">Personal Tools</view>
    <view class="subtitle">个人工具集 · 让生活更高效</view>
  </view>

  <!-- 工具列表 -->
  <view class="tool-grid">
    <view
      class="tool-item card"
      wx:for="{{tools}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="onToolTap"
    >
      <view class="tool-icon">{{item.icon}}</view>
      <view class="tool-info">
        <view class="tool-name">{{item.name}}</view>
        <view class="tool-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <text class="footer-text">© 2026 Personal Tools</text>
  </view>
</view>
