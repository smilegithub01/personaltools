/* app.wxss - 全局设计系统
 * 设计令牌：配色 / 字体 / 卡片 / 按钮 / 动效
 * 所有页面共享，保证视觉一致、专业、自然。
 */

page {
  /* 背景：温和的米白粉调，营造自然呼吸感 */
  background-color: #faf6f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    Helvetica, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #1d1d1f;
  font-size: 28rpx;
  line-height: 1.6;
  /* 平滑字体渲染 */
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

/* ---------- 通用卡片 ---------- */
/* 统一圆角、留白与柔和阴影，建立清晰层次 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(24, 53, 45, 0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

/* 区块标题：清晰的字号/字重对比 */
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: 0.5rpx;
  margin-bottom: 20rpx;
}

/* ---------- 通用按钮 ---------- */
/* 主按钮：柔珊瑚渐变，统一圆角与按压反馈 */
.btn-primary {
  background: linear-gradient(135deg, #ff9a9e, #ff7e8a);
  color: #ffffff;
  border-radius: 16rpx;
  padding: 22rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 126, 138, 0.28);
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  opacity: 0.92;
  box-shadow: 0 4rpx 12rpx rgba(255, 126, 138, 0.22);
}

/* 次级/浅色按钮 */
.btn-ghost {
  background: #f1f3f1;
  color: #4b5563;
  border-radius: 16rpx;
  padding: 22rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-ghost:active {
  transform: scale(0.97);
  background: #e7eae7;
}

/* ---------- 通用文本层级 ---------- */
.text-strong { color: #1d1d1f; font-weight: 600; }
.text-muted { color: #6b7280; }
.text-weak { color: #9ca3af; }
.text-accent { color: #ff6f80; }
.text-pos { color: #2fa86a; }

/* ---------- 入场动画 ---------- */
/* 卡片级淡入上移，营造自然过渡 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.anim-in {
  animation: fadeUp 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* 通用可点击元素的轻反馈 */
.tap {
  transition: transform 0.15s ease, background 0.15s ease;
}
.tap:active {
  transform: scale(0.97);
}

/* ---------- 线性图标系统（SVG，无 emoji） ---------- */
/* 统一 1.8 描边、圆角端点、24x24 viewBox，矢量清晰、随主题统一 */
.icon {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
  vertical-align: middle;
}
