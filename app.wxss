/* app.wxss - 全局样式 */

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    Helvetica, Segoe UI, Arial, Roboto, "PingFang SC",
    "Hiragino Sans GB", "Microsoft Yahei", sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

/* 通用按钮 */
.btn-primary {
  background-color: #07c160;
  color: #ffffff;
  border-radius: 8rpx;
  padding: 20rpx 32rpx;
  text-align: center;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.85;
}
